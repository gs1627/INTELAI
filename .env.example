# Backend deployment settings (never embed secrets in the frontend)
ARENA_DATABASE_URL=sqlite:///./arena.db
ARENA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ARENA_ADMIN_TOKEN=replace-with-a-long-random-secret

# Local companion settings. Keep the runner bound to localhost only.
ARENA_RUNNER_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ARENA_MODEL_PATH=
